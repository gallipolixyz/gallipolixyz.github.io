</span><span>  <span style="color: rgb(204, 123, 244);">return</span> res<span style="color: rgb(211, 215, 222);">.</span><span style="color: rgb(112, 184, 255);">status</span><span style="color: rgb(211, 215, 222);">(</span><span style="color: rgb(94, 237, 237);">403</span><span style="color: rgb(211, 215, 222);">).</span><span style="color: rgb(112, 184, 255);">json</span><span style="color: rgb(211, 215, 222);">({</span> <span style="color: rgb(244, 123, 133);">error</span><span style="color: rgb(211, 215, 222);">:</span> <span style="color: rgb(155, 233, 99);">'Forbidden'</span> <span style="color: rgb(211, 215, 222);">});</span>
</span><span><span style="color: rgb(211, 215, 222);">}</span></span></span></code></pre></div></div>

